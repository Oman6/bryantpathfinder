# --- Required for the Vision audit-parse path (always uses Claude) ---
# Get a key at https://console.anthropic.com (paid).
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- LLM provider for text generation (explain_schedule, rank_schedules, parse_audit_text) ---
# anthropic = Claude Sonnet (default; uses ANTHROPIC_API_KEY above; paid)
# groq      = Llama 3.3 70B via Groq (free tier, sign up at https://console.groq.com)
LLM_PROVIDER=anthropic

# --- Required if LLM_PROVIDER=groq ---
# Get a free key at https://console.groq.com/keys
# Free-tier limits: 30 requests/min, 6,000 requests/day — well above pilot needs.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional Anthropic model override (used by both Vision and text paths) ---
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: skip the live Banner SSB fetch on startup (faster reload) ---
# Set to 1 in dev to use the cached snapshot instead of pulling 810 sections.
PATHFINDER_SKIP_LIVE_FETCH=0

# --- Optional: CORS origins (comma-separated) ---
# Defaults to localhost:3000 and localhost:3001.
# ALLOWED_ORIGINS=https://your-pilot-domain.bryant.edu

# --- Optional: Scorecard API key (DEMO_KEY works for low volume) ---
# SCORECARD_API_KEY=DEMO_KEY
